<div class="modal-header border-0 pb-0">
    <div class="w-100">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h4 class="modal-title fw-bold mb-0" id="productModalLabel">{{ product.title }}</h4>
                <span class="badge bg-light text-secondary border">{{ product.brand }}</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
    </div>
</div>

<div class="modal-body">
    <div class="row g-4">
        {# left column #}
        <div class="col-md-5">
            <div class="card border-0 h-100">
                <div class="card-body">
                    <h3 class="text-primary mb-1">
                        ${{ (product.price * (1 - product.discountPercentage / 100))|number_format(2) }}
                    </h3>
                    {% if product.discountPercentage > 0 %}
                        <div class="mb-3">
                            <span class="text-decoration-line-through text-muted small">${{ product.price|number_format(2) }}</span>
                            <span class="badge bg-danger ms-1">-{{ product.discountPercentage }}%</span>
                        </div>
                    {% endif %}

                    <div class="d-flex align-items-center mb-3">
                        <div class="text-warning me-2">
                            {% for i in 1..5 %}
                                {% if i <= product.rating|round %}
                                    <i class="bi bi-star-fill">★</i>
                                {% else %}
                                    <i class="bi bi-star text-muted">☆</i>
                                {% endif %}
                            {% endfor %}
                        </div>
                        <span class="small text-muted fw-bold">({{ product.rating }})</span>
                    </div>

                    <hr>

                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2"><strong>Stock:</strong> {{ product.stock }} units</li>
                        <li class="mb-2"><strong>Warranty:</strong> {{ product.warrantyInfo }}</li>
                    </ul>
                </div>
            </div>
        </div>

        {# right column #}
        <div class="col-md-7">
            <h6>Description</h6>
            <p class="text-secondary small">{{ product.description }}</p>

            <div class="mt-3">
                {% for tag in product.tags %}
                    <span class="badge rounded-pill bg-outline-primary border text-primary fw-normal">#{{ tag }}</span>
                {% endfor %}
            </div>
        </div>
    </div>

    {# reviews #}
    <div class="mt-5">
        <h6 class="border-bottom pb-2 mb-3">Customer Reviews</h6>
        {% if product.reviews is empty %}
            <p class="text-muted small italic">No reviews yet.</p>
        {% else %}
            <div class="list-group list-group-flush">
                {% for review in product.reviews %}
                    <div class="list-group-item px-0 border-0 mb-2">
                        <div class="d-flex justify-content-between">
                            <strong class="small">{{ review.reviewerName|default('Anonymous') }}</strong>
                            <span class="text-warning small text-end">
                                {% for i in 1..5 %}
                                    {% if i <= product.rating|round %}
                                        <i class="bi bi-star-fill">★</i>
                                    {% else %}
                                        <i class="bi bi-star text-muted">☆</i>
                                    {% endif %}
                                {% endfor %}
                            </span>
                        </div>
                        <p class="mb-0 small text-muted italic">"{{ review.comment }}"</p>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<div class="modal-footer border-0">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>