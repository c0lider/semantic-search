{# partials/search-result.html.twig #}

{% if result is defined and result is not null %}

    <li class="list-group-item d-flex align-items-center">
        <div class="me-auto">
            <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                <h5 class="fw-bold fs-5">{{ result.title }}</h5>
                {% if result.brand is not empty %}

                    <span class="badge bg-light text-secondary border small">
                        {{ result.brand }}
                    </span>

                {% endif %}
            </div>

            <p class="mb-0 text-muted text-truncate" style="max-width: 1000px;">
                {{ result.description }}
            </p>
        </div>

        <div class="">
            <a href="/product/details/{{ result.id }}"
               class="btn btn-outline-primary btn-sm btn-detail-trigger text-nowrap"
               data-product-id="{{ result.id }}"
               data-bs-toggle="modal"
               data-bs-target="#resultDetailsModal"
            >
                See details
            </a>
        </div>

    </li>

{% endif %}
