{# partials/search-result-list.html.twig #}

{% if results is defined and results is not empty %}
    <div class="row mb-3">
        <div class="col-12">
            Found {{ results.totalHits }} results of type '{{ type }}' in {{ results.time }} ms.
        </div>
    </div>

    <ul class="list-group mb-5" data-bs-theme="dark">

        {% for dto in results.dtos %}
            {% include 'partials/search-result.html.twig' with {'dto': dto} %}
        {% endfor %}

    </ul>
{% endif %}
