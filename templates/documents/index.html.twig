{# documents/index.html.twig #}

{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1>
                    Willkommen bei der semantischen Suche.
                </h1>
            </div>
        </div>

        <div class="row mt-5 mb-3">
            <div class="col-12 px-5">

                <form id="search-form" role="search" class="d-flex gap-3">
                    <input id="search-input" class="form-control me-2 text-black" type="search" aria-label="Search">
                    <button class="btn btn-primary" type="submit">Suchen</button>
                </form>

            </div>
        </div>

        <div id="search-info" class="row mb-3" hidden>
            <div class="col-12">

            </div>
        </div>

        <div id="search-results" class="row">

        </div>
    </div>

    <div class="modal fade" id="resultDetailsModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="resultDetailsModalContent">
                <div class="modal-body text-center p-5">
                    <div class="spinner-border text-primary" role="status">

                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}